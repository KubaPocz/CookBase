<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CookBase.CategoriesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="CategoriesPage">
    <ScrollView BackgroundColor="LightGray">
        <VerticalStackLayout BackgroundColor="LightGrey">

            <Grid
                Padding="10,0"
                BackgroundColor="LightGrey"
                ColumnDefinitions="Auto,*,Auto"
                HeightRequest="60">
                <Button
                    BackgroundColor="LightGrey"
                    Clicked="OnHomeClicked"
                    FontAttributes="Bold"
                    FontSize="{OnIdiom Desktop=30,
                                       Tablet=27,
                                       Phone=25}"
                    HeightRequest="60"
                    Text="Wstecz"
                    TextColor="Orange" />
            </Grid>
            <Label
                Margin="0,8,0,8"
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="Kategorie"
                TextColor="Black" />
            <VerticalStackLayout
                x:Name="CategoriesList"
                Margin="{OnIdiom Phone=16,
                                 Tablet=20,
                                 Desktop=60}"
                Padding="0,0,0,16"
                BindableLayout.ItemsSource="{Binding Categories}"
                Spacing="10">
                <Label
                    Margin="0,8,0,8"
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalOptions="Center"
                    Text="Kategorie"
                    TextColor="Black" />

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Margin="0"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light=#F8F9FA,
                                                              Dark=#2D3748}"
                            BorderColor="{AppThemeBinding Light=#E9ECEF,
                                                          Dark=#4A5568}"
                            CornerRadius="18"
                            HasShadow="True">

                            <Grid
                                ColumnDefinitions="Auto, *"
                                ColumnSpacing="40"
                                VerticalOptions="Center">

                                <Image
                                    Grid.Column="0"
                                    Aspect="AspectFit"
                                    HeightRequest="{OnIdiom Phone=44,
                                                            Tablet=52,
                                                            Desktop=64}"
                                    Source="{Binding IconPath}"
                                    VerticalOptions="Center"
                                    WidthRequest="{OnIdiom Phone=44,
                                                           Tablet=52,
                                                           Desktop=64}" />

                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="{OnIdiom Phone=18,
                                                       Tablet=20,
                                                       Desktop=22}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}"
                                    TextColor="{AppThemeBinding Light=#2D3748,
                                                                Dark=#F7FAFC}"
                                    VerticalOptions="Center" />
                            </Grid>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryTapped" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>