<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CookBase.ProductsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Produkty">

    <!-- ZAMIANA: Grid jako root, ostatni wiersz * dla listy -->
    <Grid BackgroundColor="LightGrey"
          RowDefinitions="Auto,Auto,Auto,*">

        <!-- Górny pasek -->
        <Grid Grid.Row="0"
              Padding="10,0"
              BackgroundColor="LightGrey"
              ColumnDefinitions="Auto,*,Auto"
              HeightRequest="60">

            <Button
                BackgroundColor="LightGrey"
                Clicked="OnHomeClicked"
                FontAttributes="Bold"
                FontSize="{OnIdiom Desktop=30, Tablet=27, Phone=25}"
                HeightRequest="60"
                Text="Wstecz"
                TextColor="Orange" />

            <Button
                Grid.Column="2"
                BackgroundColor="LightGrey"
                Clicked="OnAddProductClicked"
                FontAttributes="Bold"
                FontSize="{OnIdiom Desktop=30, Tablet=27, Phone=25}"
                HeightRequest="60"
                Text="Dodaj"
                TextColor="Orange" />
        </Grid>

        <!-- Tytuł -->
        <Label Grid.Row="1"
               Margin="0,8,0,8"
               FontAttributes="Bold"
               FontSize="28"
               HorizontalOptions="Center"
               Text="Produkty"
               TextColor="Black" />

        <!-- Filtry -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="16,10"
                             Spacing="10">

            <Picker
                x:Name="CategoryFilterPicker"
                Title="Wybierz kategorię"
                BackgroundColor="White"
                SelectedIndexChanged="OnFiltersChanged" />

            <SearchBar
                x:Name="SearchBar"
                BackgroundColor="White"
                Placeholder="Szukaj produktu po nazwie…"
                TextChanged="OnFiltersChanged" />
        </VerticalStackLayout>

        <!-- LISTA: wiersz * -> scroll działa -->
        <CollectionView Grid.Row="3"
                        x:Name="ProductsList"
                        Margin="16,0,16,16"
                        SelectionMode="None"
                        EmptyView="Brak produktów dla wybranych filtrów."
                        VerticalOptions="FillAndExpand">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    Text="Edytuj"
                                    BackgroundColor="#F59E0B"
                                    CommandParameter="{Binding .}"
                                    Invoked="OnEditProductInvoked" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame Margin="0,4"
                               Padding="12"
                               CornerRadius="16"
                               HasShadow="True">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  RowDefinitions="Auto,Auto">

                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold" />

                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding Category.Name}"
                                       FontSize="14"
                                       Opacity="0.75" />

                                <Button Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Text="Edytuj"
                                        FontAttributes="Bold"
                                        BackgroundColor="Orange"
                                        TextColor="Black"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnEditProductClicked" />
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>
