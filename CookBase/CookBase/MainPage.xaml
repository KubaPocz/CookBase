<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CookBase.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid Padding="30">
        <VerticalStackLayout
            Spacing="25"
            HorizontalOptions="Center">

            <Label 
                Text="Cook Base"
                FontSize="60"
                FontAttributes="Bold"
                VerticalOptions="Start"
                HorizontalOptions="Center"/>

            <Button 
                Text="Przepisy"
                WidthRequest="200"
                HeightRequest="50"
                CornerRadius="12"
                FontSize="18"
                VerticalOptions="Center"
                Clicked="OnPrzepisyClicked" />

            <Button 
                Text="Produkty"
                WidthRequest="200"
                HeightRequest="50"
                CornerRadius="12"
                FontSize="18"
                VerticalOptions="Center"
                Clicked="OnProduktyClicked" />

            <Button 
                Text="Kategorie"
                WidthRequest="200"
                HeightRequest="50"
                CornerRadius="12"
                FontSize="18"
                VerticalOptions="Center"
                Clicked="OnKategorieClicked" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>